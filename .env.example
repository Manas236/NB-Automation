# Copy to .env (never commit .env). Loaded automatically by Insta_poster.py / app.py.
# Restart the dashboard after editing - the Flask reloader does not watch this file.

# --- Instagram Graph API (from Meta) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Which API host your token belongs to:
#   graph.instagram.com  - "Instagram API with Instagram Login" (default)
#   graph.facebook.com   - Instagram via Facebook Login / Page-linked account
INSTAGRAM_API_HOST=graph.instagram.com
INSTAGRAM_API_VERSION=v26.0

# --- Image hosting ---
# Meta's API cannot take an upload: it downloads the image from a URL you give it. The poster
# converts the post PNG to JPEG, puts it on one of these hosts and hands Instagram that URL.
# The dashboard itself stays LAN-only.
#   cloudinary - signed upload; the copy is deleted again as soon as the post is published
#   imgbb      - the copy expires by itself after IMGBB_EXPIRATION seconds
# If Instagram cannot fetch the first host's URL (it has happened to both on different days),
# the same JPEG is re-uploaded to the fallback and the post is retried once.
NB_IMAGE_HOST=cloudinary
NB_IMAGE_HOST_FALLBACK=imgbb
# NB_IMAGE_KEEP=1     # keep the hosted copy instead of deleting it after publishing

# --- Cloudinary (https://console.cloudinary.com - "Product Environment" box) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=newsband-ig
# CLOUDINARY_UPLOAD_PRESET=   # instead of key/secret: an unsigned preset (then no cleanup)

# --- imgbb (https://api.imgbb.com) ---
IMGBB_API_KEY=
IMGBB_EXPIRATION=3600

# --- Autopilot (the poller inside app.py) ---
# NB_AUTOPILOT=0        # start the dashboard with the autopilot paused
# NB_AUTOPOST=0         # start in "Create only" mode (the dashboard's mode switch overrides this once used)
# NB_TODAY_ONLY=0       # also handle unseen articles from earlier days
# NB_POLL_INTERVAL=900  # seconds between sitemap checks
# NB_MAX_PER_POLL=3     # articles rendered per pass (publishing is paced separately)
# NB_MAX_PER_DAY=10     # posts published per day (Instagram's own limit is 100/24h)
# NB_MIN_GAP_MINUTES=30 # minimum minutes between two publishes; 0 disables pacing (don't)
# NB_API_MIN_GAP_SECONDS=120  # hard floor between ANY two publishes (dashboard button too); never below 60.
#                             # Dashboard clicks are queued and sent this + 0-60 s random apart (2-3 min).

# --- Dashboard login -------------------------------------------------------------------------
# Required on the public server (wsgi.py refuses to start without a password). Leave empty on
# the office PC = no login, as before. See deploy/DEPLOY.md.
NB_DASH_USER=newsband
NB_DASH_PASSWORD=
